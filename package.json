{
  "name": "bvmf",
  "version": "1.1.8",
  "description": "A TypeScript library for retrieving Brazilian stock quotes from StatusInvest",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.(js|ts)\"",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --fix --ext .js,.ts",
    "test": "jest --config jest.config.js",
    "test:cov": "npm run test -- --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebertcisco/bvmf.git"
  },
  "keywords": [
    "promise",
    "typescript",
    "quotes",
    "invest",
    "stock"
  ],
  "author": "Hebert Cisco",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hebertcisco/bvmf/issues"
  },
  "homepage": "https://github.com/hebertcisco/bvmf#readme",
  "engines": {
    "node": ">=18.17.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/random-useragent": "^0.3.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^29.0.0",
    "jest": "^30.2.0",
    "jest-cucumber": "^4.5.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib/**/*"
  ],
  "dependencies": {
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "iconv-lite": "^0.6.3",
    "random-useragent": "^0.5.0",
    "slugify": "^1.6.6",
    "zod": "^4.1.12"
  }
}
